<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!--
      Telerik UI for WPF is a commercial product and needs a private NuGet feed.
      It is NOT required to build this solution. The shell abstractions in
      Corp.Identity.Shell have a plain-WPF implementation that compiles today.

      To switch to Telerik once your licence and feed are configured:
        dotnet build -p:UseTelerik=true
      or set the property here permanently.

      See README.md §8.12 and DEMO.md "Enabling Telerik".
    -->
    <UseTelerik Condition="'$(UseTelerik)' == ''">false</UseTelerik>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseTelerik)' == 'true'">
    <DefineConstants>$(DefineConstants);TELERIK</DefineConstants>
  </PropertyGroup>

</Project>
