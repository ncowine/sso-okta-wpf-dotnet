<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Common.Authentication</RootNamespace>
  </PropertyGroup>

  <!--
    Everything needed to sign a user in lives in this one assembly.

    No UI framework: nothing here references WPF, so the same library serves a
    WPF app, a WinForms app, or a background host. Your view models depend on
    IAuthenticationService and nothing else.

    Every package below is published by Microsoft. There is no third-party
    dependency to get approved.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- The protocol and callback types are internal: they are how this works, not what
         you bind to. The tests still need them, because they are the security-critical
         part. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Common.Authentication.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
