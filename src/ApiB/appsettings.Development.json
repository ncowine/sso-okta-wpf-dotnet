{
  "//": "Points ApiB at the local DevIdp instead of Okta. Development only - see tools/DevIdp.",
  "Delegation": {
    "Pattern": "OnBehalfOf"
  },
  "Okta": {
    "Issuer": "https://localhost:7100/oauth2/apib-as",
    "Audience": "api://apib",
    "Service": {
      "ClientId": "apib-service",
      "SigningCertificateThumbprint": ""
    },
    "Downstream": {
      "ApiA": {
        "BaseAddress": "https://localhost:7201/",
        "Audience": "api://apia",
        "Scopes": "apia.read",
        "Issuer": "https://localhost:7100/oauth2/apia-as"
      }
    }
  }
}
