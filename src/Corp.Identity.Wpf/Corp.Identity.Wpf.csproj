<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    WPF only. No Prism, no DI container, no third-party package: a plain WPF
    application can reference this and Corp.Identity.Core and be done.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Corp.Identity.Core\Corp.Identity.Core.csproj" />
  </ItemGroup>

</Project>
