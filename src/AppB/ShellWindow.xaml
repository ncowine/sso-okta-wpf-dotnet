<Window x:Class="AppB.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppB - Billing"
        Height="720" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ground}">

    <Grid>
        <DockPanel>

            <!-- Who is signed in, and how to stop being signed in -->
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="AppB" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="{Binding SignedInAs}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Sign out" Command="{Binding SignOutCommand}"
                                ToolTip="Forgets this application's tokens. The browser session survives, so relaunching signs you straight back in." />
                        <Button Content="Sign out everywhere" Command="{Binding SignOutEverywhereCommand}"
                                ToolTip="Ends the session at the identity provider. Signs you out of every other application too." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Padding="20,8">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding Status}" />
            </Border>

            <!-- The API surface. DataContext narrows to the feature view model. -->
            <DockPanel Margin="20" DataContext="{Binding Billing}">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource H1}" Text="Cross-application SSO" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="If you launched AppA first and were not asked to sign in here, you have just watched cross-application SSO work. AppB got its own separate tokens; only the browser session was shared." />
                </StackPanel>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Who am I?" Command="{Binding WhoAmICommand}"
                            ToolTip="GET invoices/whoami - AppB's own token, from its own authorization server." />
                    <Button Content="Get invoice" Command="{Binding InvoiceCommand}"
                            ToolTip="Requires the App-Finance group. Alice succeeds, Bob is denied." />
                    <Button Content="Call ApiA from ApiB" Command="{Binding OrderContextCommand}"
                            ToolTip="The return direction. Trust between APIs is configured per direction." />
                    <Button Content="Trip the cycle guard" Command="{Binding CycleCommand}"
                            ToolTip="ApiB calls ApiA calls ApiB, until the depth guard returns 508." />
                </WrapPanel>

                <TextBox Style="{StaticResource Mono}" Text="{Binding Output, Mode=OneWay}" />
            </DockPanel>
        </DockPanel>

        <!-- Busy overlay, shown while signing in or out -->
        <Border Background="#B0FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="4"
                             Foreground="{StaticResource Accent}" />
                <TextBlock Text="{Binding BusyMessage}" Margin="0,16,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource Ink}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
