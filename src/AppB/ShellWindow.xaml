<Window x:Class="AppB.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:AppB"
        Title="AppB — Billing"
        Height="720" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ground}">

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="AppB" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="{Binding SignedInAs}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Sign out (local)" Command="{Binding SignOutLocalCommand}"
                                ToolTip="Discards local tokens. The Okta session survives, so relaunching signs you straight back in (README §11.1)." />
                        <Button Content="Sign out (global)" Command="{Binding SignOutGlobalCommand}"
                                ToolTip="Ends the Okta session. You will be signed out of every Corp application (README §11.2)." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Padding="20,8">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusMessage}" />
            </Border>

            <ContentControl prism:RegionManager.RegionName="MainRegion" Margin="20" />
        </DockPanel>

        <!--
            Busy overlay. Plain WPF here; with -p:UseTelerik=true this is where a
            RadBusyIndicator wraps the region instead (README §8.12).
        -->
        <Border Background="#B0FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="240" Height="4"
                             Foreground="{StaticResource Accent}" />
                <TextBlock Text="{Binding BusyMessage}" Margin="0,16,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource Ink}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
