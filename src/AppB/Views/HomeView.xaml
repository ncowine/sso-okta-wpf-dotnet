<UserControl x:Class="AppB.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource H1}" Text="Billing — the return direction" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="AppB is a separate Okta client with its own tokens. It exercises ApiB, including ApiB calling back into ApiA, and the delegation depth guard." />
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button Content="Who am I? (ApiB)" Command="{Binding WhoAmICommand}"
                    ToolTip="GET /invoices/whoami — how ApiB sees AppB's token." />
            <Button Content="Get invoice" Command="{Binding InvoiceCommand}"
                    ToolTip="GET /invoices/{id} — requires App-Finance. Alice succeeds, Bob is denied." />
            <Button Content="ApiB → ApiA (on behalf of me)" Command="{Binding OrderContextCommand}"
                    ToolTip="GET /invoices/{id}/order-context — the return direction of the bidirectional relationship." />
            <Button Content="Trip the cycle guard" Command="{Binding CycleCommand}"
                    ToolTip="GET /invoices/cycle-demo — drives ApiB → ApiA → ApiB until the depth guard returns 508 (README §7.7)." />
            <Button Content="Summary (service-safe)" Command="{Binding SummaryCommand}"
                    ToolTip="GET /invoices/summary — aggregate data with no per-user component." />
        </WrapPanel>

        <TextBox Style="{StaticResource Mono}" Text="{Binding Output, Mode=OneWay}" />
    </DockPanel>
</UserControl>
